<section class="page-section card">
  <h2>Dashboard</h2>
  <div style="display:flex; gap:16px; align-items:center;">
    <div class="card" style="padding:16px;">
      <div>Total students</div>
      <div style="font-size:28px;font-weight:600"><%= totalStudents %></div>
    </div>

    <div class="card" style="padding:16px;">
      <div>Overall records</div>
      <div style="font-size:28px;font-weight:600"><%= totalRecords %></div>
    </div>

    <div class="card" style="padding:16px;">
      <div>Overall present %</div>
      <div style="font-size:28px;font-weight:600"><%= overallPercentage %>%</div>
    </div>
  </div>
</section>
